# ─── Gapo Work URL ─────────────────────────────────────────────────────
GAPO_WORK_URL=https://work.gapo.vn

# ─── Browser ───────────────────────────────────────────────────────────
# Set BROWSER_HEADLESS=0 to watch the bot drive a real Chromium (debug).
BROWSER_HEADLESS=1
BROWSER_SLOWMO_MS=0
# Where cookies + localStorage are persisted. Defaults to
# ~/.openclaw/plugins/browser-tools/storage-state.json
# Override to keep multiple bot accounts separate.
# BROWSER_STORAGE_STATE=

# ─── Auth shared with bb-pm-tools (fallback path) ──────────────────────
# Generate with `openssl rand -hex 32`. Same secret must be set in
# bb-pm-tools as BROWSER_TOOLS_TOKEN so /agent/run can call us.
BROWSER_TOOLS_TOKEN=

# ─── DM rate limit (anti-bot heuristic) ────────────────────────────────
BROWSER_MAX_DMS_PER_HOUR=30
