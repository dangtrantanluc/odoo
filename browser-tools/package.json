{
  "name": "@openclaw/browser-tools",
  "version": "0.1.0",
  "description": "OpenClaw plugin — Playwright-driven browser automation for chat platforms (Gapo, etc.) when bot APIs are insufficient.",
  "main": "dist/index.js",
  "type": "commonjs",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "auth": "tsx src/auth-cli.ts"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
