// BB-PM database schema — standalone Postgres backing the PM Operations Agent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Support tables
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model Company {
  id         Int      @id @default(autoincrement())
  name       String
  code       String?  @unique
  currencyId Int      @map("currency_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  currency    Currency     @relation(fields: [currencyId], references: [id])
  users       User[]
  projects    Project[]
  tasks       Task[]
  backlogs    Backlog[]
  automations Automation[]

  @@map("companies")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String    @map("full_name")
  avatarUrl     String?   @map("avatar_url")
  lang          String    @default("vi_VN")
  timezone      String    @default("Asia/Ho_Chi_Minh")
  role          Role      @default(MEMBER)
  companyId     Int       @map("company_id")
  active        Boolean   @default(true)
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  // Org metadata — populated from Gapo profile via bulk-from-gapo.
  // Used by the agent for workload-balanced task distribution + skill matching.
  department    String?
  position      String?
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company           Company         @relation(fields: [companyId], references: [id])
  ownedProjects     Project[]       @relation("ProjectOwner")
  amProjects        Project[]       @relation("ProjectAM")
  assignedTasks     Task[]          @relation("TaskAssignee")
  loggedBacklogs    Backlog[]       @relation("BacklogLogger")
  approvedBacklogs  Backlog[]       @relation("BacklogApprover")
  memberships       Member[]
  assignedScopes    Scope[]         @relation("ScopeAssignee")
  gapoMap           GapoUserMap?
  channelIdentities ChannelIdentity[]
  checkinSession    CheckinSession?
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  agentFollowUps    AgentFollowUp[]
  ownedAutomations  Automation[]    @relation("AutomationOwner")

  @@index([companyId, active])
  @@map("users")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  title     String
  message   String?   @db.Text
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  taxCode   String?  @map("tax_code")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@index([name])
  @@map("customers")
}

model Currency {
  id     Int      @id @default(autoincrement())
  code   String   @unique
  symbol String
  rate   Decimal  @default(1.0) @db.Decimal(20, 6)

  companies    Company[]
  projects     Project[]
  tasks        Task[]
  backlogs     Backlog[]
  memberRates  MemberRate[]
  scopes       Scope[]

  @@map("currencies")
}

// ─────────────────────────────────────────────────────────────
// Domain tables
// ─────────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id   Int    @id @default(autoincrement())
  name String
  code String? @unique

  status      ProjectStatus @default(PLANNED)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?     @db.Date  @map("start_date")
  endDate     DateTime?     @db.Date  @map("end_date")
  description String?       @db.Text

  budget              Decimal? @db.Decimal(18, 2)
  estimatedTotalCost  Decimal? @db.Decimal(18, 2) @map("estimated_total_cost")
  estimatedTotalHours Float?   @map("estimated_total_hours")

  // cached rollups
  totalCost       Decimal @default(0) @db.Decimal(18, 2) @map("total_cost")
  totalHours      Float   @default(0) @map("total_hours")
  budgetRemaining Decimal? @db.Decimal(18, 2) @map("budget_remaining")
  taskCount       Int     @default(0) @map("task_count")
  memberCount     Int     @default(0) @map("member_count")
  backlogCount    Int     @default(0) @map("backlog_count")
  scopeCount      Int     @default(0) @map("scope_count")
  milestoneCount  Int     @default(0) @map("milestone_count")

  ownerId          Int    @map("owner_id")
  companyId        Int    @map("company_id")
  customerId       Int?   @map("customer_id")
  accountManagerId Int?   @map("account_manager_id")
  currencyId       Int?   @map("currency_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner          User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  accountManager User?     @relation("ProjectAM", fields: [accountManagerId], references: [id])
  company        Company   @relation(fields: [companyId], references: [id])
  customer       Customer? @relation(fields: [customerId], references: [id])
  currency       Currency? @relation(fields: [currencyId], references: [id])

  tasks       Task[]
  members     Member[]
  milestones  Milestone[]
  scopes      Scope[]
  backlogs    Backlog[]
  memberRates MemberRate[]
  tags        ProjectTag[]
  meetings    Meeting[]

  @@index([companyId, status])
  @@index([customerId])
  @@map("projects")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Task {
  id          Int        @id @default(autoincrement())
  name        String
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  deadline    DateTime?  @db.Date
  endAt       DateTime?  @db.Date @map("end_at")
  description String?    @db.Text
  result      String?    @db.Text
  issues      String?    @db.Text

  totalCost  Decimal @default(0) @db.Decimal(18, 2) @map("total_cost")
  totalHours Float   @default(0) @map("total_hours")

  projectId   Int  @map("project_id")
  companyId   Int? @map("company_id")
  assigneeId  Int? @map("assignee_id")
  milestoneId Int? @map("milestone_id")
  currencyId  Int? @map("currency_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company   Company?   @relation(fields: [companyId], references: [id])
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  currency  Currency?  @relation(fields: [currencyId], references: [id])

  backlogs Backlog[]
  tags     TaskTag[]
  scopes   Scope[]
  blockers TaskBlocker[]
  followUps AgentFollowUp[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([milestoneId])
  @@map("tasks")
}

enum BacklogStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BacklogSource {
  MANUAL
  GAPO_CHECKIN
}

model Backlog {
  id                  Int           @id @default(autoincrement())
  status              BacklogStatus @default(PENDING)
  source              BacklogSource @default(MANUAL)
  workDate            DateTime      @db.Date @map("work_date")
  description         String?       @db.Text
  hours               Decimal       @db.Decimal(6, 2)
  costPerHourSnapshot Decimal?      @db.Decimal(18, 2) @map("cost_per_hour_snapshot")
  totalCostSnapshot   Decimal?      @db.Decimal(18, 2) @map("total_cost_snapshot")

  taskId         Int?      @map("task_id")
  projectId      Int       @map("project_id")
  companyId      Int?      @map("company_id")
  userId         Int       @map("user_id")
  currencyId     Int?      @map("currency_id")
  approverId     Int?      @map("approver_id")
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task     Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project  Project   @relation(fields: [projectId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id])
  user     User      @relation("BacklogLogger", fields: [userId], references: [id])
  approver User?     @relation("BacklogApprover", fields: [approverId], references: [id])
  currency Currency? @relation(fields: [currencyId], references: [id])

  @@index([taskId, status])
  @@index([projectId, status])
  @@index([userId, workDate])
  @@map("backlogs")
}

model Member {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  userId    Int      @map("user_id")
  role      String?
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id])
  rates   MemberRate[]

  @@unique([projectId, userId])
  @@index([userId])
  @@map("members")
}

model MemberRate {
  id            Int       @id @default(autoincrement())
  memberId      Int       @map("member_id")
  projectId     Int?      @map("project_id")
  userId        Int?      @map("user_id")
  currencyId    Int?      @map("currency_id")
  effectiveFrom DateTime  @db.Date @map("effective_from")
  effectiveTo   DateTime? @db.Date @map("effective_to")
  costPerHour   Decimal   @db.Decimal(18, 2) @map("cost_per_hour")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  member   Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id])
  currency Currency? @relation(fields: [currencyId], references: [id])

  @@index([memberId, effectiveFrom])
  @@map("member_rates")
}

model Milestone {
  id             Int       @id @default(autoincrement())
  name           String
  status         String?
  dueDate        DateTime? @db.Date @map("due_date")
  description    String?   @db.Text
  taskCount      Int       @default(0) @map("task_count")
  doneCount      Int       @default(0) @map("done_count")
  completionPct  Int       @default(0) @map("completion_pct")
  projectId      Int       @map("project_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@map("milestones")
}

model Scope {
  id             Int      @id @default(autoincrement())
  sequence       Int      @default(10)
  name           String
  notes          String?  @db.Text
  estimatedHours Decimal? @db.Decimal(8, 2) @map("estimated_hours")
  estimatedRate  Decimal? @db.Decimal(18, 2) @map("estimated_rate")
  estimatedCost  Decimal? @db.Decimal(18, 2) @map("estimated_cost")
  projectId      Int      @map("project_id")
  taskId         Int?     @map("task_id")
  assigneeId     Int?     @map("assignee_id")
  currencyId     Int?     @map("currency_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?     @relation(fields: [taskId], references: [id])
  assignee User?     @relation("ScopeAssignee", fields: [assigneeId], references: [id])
  currency Currency? @relation(fields: [currencyId], references: [id])

  @@index([projectId, sequence])
  @@map("scopes")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects ProjectTag[]
  tasks    TaskTag[]

  @@map("tags")
}

model ProjectTag {
  projectId Int     @map("project_id")
  tagId     Int     @map("tag_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tags")
}

model TaskTag {
  taskId Int  @map("task_id")
  tagId  Int  @map("tag_id")
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model GapoUserMap {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  gapoUserId   BigInt   @map("gapo_user_id")
  gapoThreadId BigInt   @map("gapo_thread_id")
  gapoFullName String?  @map("gapo_full_name")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gapoUserId])
  @@map("gapo_user_maps")
}

// ─────────────────────────────────────────────────────────────
// Multi-channel identity (Sprint 6 — Polish)
// Generic mapping user ↔ external platform (Gapo/Slack/Zalo/Telegram/Email).
// One user can have multiple rows per channel (e.g. 2 Telegram chats) —
// `preferred` marks the default for send_follow_up routing.
// GapoUserMap is kept for back-compat; ChannelIdentity is the new read path.
// ─────────────────────────────────────────────────────────────

enum ChannelKind {
  gapo
  slack
  zalo
  zalouser
  telegram
  email
  sms
}

model ChannelIdentity {
  id           Int         @id @default(autoincrement())
  userId       Int         @map("user_id")
  channel      ChannelKind
  externalId   String      @map("external_id")
  externalName String?     @map("external_name")
  threadId     String?     @map("thread_id")
  preferred    Boolean     @default(false)
  lastSeenAt   DateTime    @default(now()) @map("last_seen_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([userId, channel, preferred])
  @@map("channel_identities")
}

// ─────────────────────────────────────────────────────────────
// Agent tables (PM Agent — OpenClaw bb-pm-tools plugin)
// ─────────────────────────────────────────────────────────────

enum AgentAuditSource {
  chat
  cron
  cli
  other
}

enum CheckinState {
  IDLE
  AWAITING_PROJECT
  AWAITING_UPDATE
  AWAITING_TASK_CONFIRM
  COMPLETED
}

model CheckinSession {
  id               Int          @id @default(autoincrement())
  userId           Int          @unique @map("user_id")
  gapoUserId       String       @map("gapo_user_id")
  threadId         String       @map("thread_id")
  currentProjectId Int?         @map("current_project_id")
  currentTaskId    Int?         @map("current_task_id")
  state            CheckinState @default(IDLE)
  expiresAt        DateTime     @map("expires_at")
  lastMessageId    String?      @map("last_message_id")
  pendingText      String?      @db.Text @map("pending_text")
  pendingParsed    Json?        @map("pending_parsed")
  completedAt      DateTime?    @map("completed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, expiresAt])
  @@map("checkin_sessions")
}

model AgentAuditLog {
  id             Int              @id @default(autoincrement())
  tool           String
  argsJson       Json             @map("args_json")
  resultJson     Json?            @map("result_json")
  errorMessage   String?          @map("error_message") @db.Text
  durationMs     Int?             @map("duration_ms")
  correlationId  String?          @map("correlation_id")
  source         AgentAuditSource @default(chat)
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([tool, createdAt])
  @@index([correlationId])
  // Sprint 8 follow-up — standalone index on createdAt cho retention cleanup
  // (DELETE WHERE created_at < cutoff). Tránh full scan khi xoá hàng tháng.
  @@index([createdAt])
  @@map("agent_audit_log")
}

enum BlockerSeverity {
  LOW
  MED
  HIGH
}

model TaskBlocker {
  id          Int             @id @default(autoincrement())
  taskId      Int             @map("task_id")
  severity    BlockerSeverity @default(MED)
  description String          @db.Text
  resolvedAt  DateTime?       @map("resolved_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, resolvedAt])
  @@map("task_blockers")
}

// ─────────────────────────────────────────────────────────────
// Agent follow-ups (Sprint 6.2 — Ops hardening)
// Persistent log of every send_follow_up that actually fired. Lets the
// agent answer "ai chưa reply?" and lets ops audit who got pinged when.
// Pairs with the Redis cooldown: cooldown enforces "don't double-ping",
// this table answers "what did we ping for?".
// ─────────────────────────────────────────────────────────────

enum FollowUpStatus {
  PENDING
  REPLIED
  EXPIRED
  CANCELLED
}

model AgentFollowUp {
  id            Int            @id @default(autoincrement())
  taskId        Int            @map("task_id")
  userId        Int            @map("user_id")
  channel       ChannelKind    @default(gapo)
  threadId      String?        @map("thread_id")
  question      String         @db.Text
  status        FollowUpStatus @default(PENDING)
  askedAt       DateTime       @default(now()) @map("asked_at")
  repliedAt     DateTime?      @map("replied_at")
  replyText     String?        @db.Text @map("reply_text")
  correlationId String?        @map("correlation_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([taskId, status])
  @@index([status, askedAt])
  @@map("agent_follow_ups")
}

// ─────────────────────────────────────────────────────────────
// Agent memory (Sprint 4 — Level 3)
// Persisted summaries of past agent runs; recalled at start of a new
// run to give the orchestrator context. Text-only today; vector column
// reserved for a future pgvector upgrade (see migration).
// ─────────────────────────────────────────────────────────────

model AgentMemory {
  id             Int              @id @default(autoincrement())
  companyId      Int              @map("company_id")
  conversationId String?          @map("conversation_id")
  source         AgentAuditSource @default(chat)
  userText       String           @db.Text @map("user_text")
  replyText      String           @db.Text @map("reply_text")
  summary        String           @db.Text
  toolsUsed      Json             @default("[]") @map("tools_used")
  projectIds     Int[]            @default([]) @map("project_ids")
  taskIds        Int[]            @default([]) @map("task_ids")
  correlationId  String?          @map("correlation_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([conversationId])
  @@map("agent_memory")
}

// ─────────────────────────────────────────────────────────────
// Meeting Assistant (Sprint 5 — Level 4 Coordinator)
// Transcript → LLM extraction → human-in-the-loop approval → tasks.
// ─────────────────────────────────────────────────────────────

enum MeetingItemStatus {
  DRAFT
  APPROVED
  REJECTED
}

model Meeting {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  projectId    Int?     @map("project_id")
  title        String?
  heldAt       DateTime @default(now()) @map("held_at")
  transcript   String   @db.Text
  summary      String?  @db.Text
  decisions    Json     @default("[]")
  participants String[] @default([])
  createdById  Int?     @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project Project?              @relation(fields: [projectId], references: [id])
  items   MeetingActionItem[]

  @@index([companyId, createdAt])
  @@index([projectId])
  @@map("meetings")
}

model MeetingActionItem {
  id             Int               @id @default(autoincrement())
  meetingId      Int               @map("meeting_id")
  title          String
  description    String?           @db.Text
  ownerName      String?           @map("owner_name")
  ownerUserId    Int?              @map("owner_user_id")
  dueDate        DateTime?         @db.Date @map("due_date")
  priority       Priority          @default(MEDIUM)
  status         MeetingItemStatus @default(DRAFT)
  createdTaskId  Int?              @map("created_task_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
  @@map("meeting_action_items")
}

// Phase 4 — recurring workflow registration. Replaces hardcoded cron env
// (CRON_DAILY_DIGEST_TARGET) với DB-backed config. Scheduler load on boot
// + register node-cron jobs per row.
model Automation {
  id             Int       @id @default(autoincrement())
  name           String                                       // human-readable label
  workflow       String                                       // workflows registry key (vd "daily_digest")
  schedule       String                                       // cron expression (vd "0 9 * * *")
  inputs         Json      @default("{}")                     // workflow-specific args
  target         String?                                      // optional Gapo cid (vd "collab:7001...")
  active         Boolean   @default(true)
  ownerId        Int       @map("owner_id")
  companyId      Int       @map("company_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt      @map("updated_at")
  lastRunAt      DateTime? @map("last_run_at")
  lastRunStatus  String?   @map("last_run_status")            // "ok" | "error"
  lastRunError   String?   @map("last_run_error")             // truncated error msg
  consecutiveFails Int     @default(0) @map("consecutive_fails")  // dead-man switch

  owner   User    @relation("AutomationOwner", fields: [ownerId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([active, schedule])
  @@index([companyId, active])
  @@map("automations")
}
