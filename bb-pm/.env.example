# ─── Postgres (bb_pm) ───────────────────────────────
POSTGRES_USER=bbpm
POSTGRES_PASSWORD=bbpm_pwd
POSTGRES_DB=bb_pm
POSTGRES_PORT=5433

# ─── API ────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://bbpm:bbpm_pwd@localhost:5433/bb_pm
JWT_SECRET=change-me-super-secret-64-chars-minimum-please-rotate
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173

# ─── Web ────────────────────────────────────────────
WEB_PORT=5173
VITE_API_BASE=http://localhost:4000/api/v1

# ─── MinIO (share với Odoo stack) ───────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=bb-pm-avatars

# ─── Migrate from Odoo ──────────────────────────────
ODOO_DATABASE_URL=postgres://admin:admin123@localhost:5432/odoo
