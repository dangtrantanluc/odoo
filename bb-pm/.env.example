# ─── Postgres (bb_pm) ───────────────────────────────
POSTGRES_USER=bbpm
POSTGRES_PASSWORD=bbpm_pwd
POSTGRES_DB=bb_pm
POSTGRES_PORT=5433

# ─── API ────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://bbpm:bbpm_pwd@localhost:5433/bb_pm
JWT_SECRET=change-me-super-secret-64-chars-minimum-please-rotate
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173

# ─── PM Agent (OpenClaw bb-pm-tools plugin) ─────────
# Must match BB_PM_AGENT_TOKEN in bb-pm-tools/.env.
AGENT_API_TOKEN=
AGENT_USER_EMAIL=pm-agent@bluebolt.local

# ─── Redis (Sprint 6.2 — Ops hardening) ─────────────
# Optional for bb-pm API: only used by /api/v1/health to ping Redis so
# operators see the full stack health from one endpoint. The cooldown +
# rate-limit consumers live in bb-pm-tools and read REDIS_URL there.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Web ────────────────────────────────────────────
WEB_PORT=5173
VITE_API_BASE=http://localhost:4000/api/v1

# ─── MinIO (avatars) ────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=bb-pm-avatars
