# ─── bb-pm API ─────────────────────────────────────────────────────────
BB_PM_API_URL=http://localhost:4000/api/v1
# Must match AGENT_API_TOKEN set on the bb-pm API service.
# Generate once with: openssl rand -hex 32
BB_PM_AGENT_TOKEN=

# ─── LLM provider selection ────────────────────────────────────────────
# "default" = self-host (Qwen/Gemma/...), "gemini" = Google Gemini compat.
# Per-call override qua chat(messages, tools, { provider: "gemini" }).
LLM_PROVIDER=default

# ─── Self-hosted LLM (OpenAI-compatible) — provider "default" ─────────
# Examples: vLLM, llama.cpp --api, Ollama (OpenAI-compat), LMDeploy
# LLM_MODEL must match the model id your endpoint advertises at /v1/models
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=nokey
LLM_MODEL=Qwen/Qwen3.6-27B-FP8
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ─── Google Gemini (OpenAI-compat endpoint) — provider "gemini" ────────
# Lấy API key tại https://aistudio.google.com/apikey
# Models: gemini-2.5-flash (rẻ/nhanh), gemini-2.5-pro (mạnh, đắt hơn)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.2

# ─── Orchestrator ──────────────────────────────────────────────────────
AGENT_MAX_STEPS=5

# ─── Concurrency limiter (Sprint 8 Phase #4) ───────────────────────────
# Cap in-flight LLM-tier requests. Match vLLM `--max-num-seqs` của host
# Qwen. Default 16 = vLLM Qwen3.6-27B-FP8 sweet spot (đo 2026-05-07).
# MAX_QUEUE: số request được wait slot trước khi reject 503.
# ACQUIRE_TIMEOUT_MS: nếu wait quá → reject 503 (default 60s).
AGENT_MAX_CONCURRENT=16
AGENT_MAX_QUEUE=30
AGENT_ACQUIRE_TIMEOUT_MS=60000

# ─── Hard timeout SLA (F4 fix) ──────────────────────────────────────────
# Cap thời gian xử lý 1 agent run. Vượt → trả friendly error + log alert.
# 300s (5 phút) — cover Qwen typical p95 (~120s) + 2.5x margin cho retry.
# Nếu thấy nhiều agent_hard_timeout → tune Qwen hoặc giảm AGENT_MAX_STEPS.
AGENT_HARD_TIMEOUT_MS=300000

# ─── Fast-path circuit breaker (F3 fix) ────────────────────────────────
# Nếu pattern fail ≥ N lần trong WINDOW giây → disable DISABLE giây.
# Tránh tool fail liên tục gây log spam + tốn perf.
FASTPATH_CB_THRESHOLD=3
FASTPATH_CB_WINDOW_MS=60000
FASTPATH_CB_DISABLE_MS=300000

# ─── Ack bubble UX ─────────────────────────────────────────────────────
# Khi LLM chậm, gửi "🕐 Đang xử lý..." vào Gapo sau N ms để user biết bot
# còn sống. Set 0 = disabled. Mặc định 15s/45s — câu nhanh không tạo
# bubble noise. Hạ xuống 5s nếu user hay re-send spam vì tưởng bot chết.
BB_PM_ACK_FIRST_DELAY_MS=15000
BB_PM_ACK_SECOND_DELAY_MS=45000

# ─── Response formatter (Sprint 8 Phase #5) ────────────────────────────
# Layer trung gian giữa orchestrator và channel-out. Biến raw agent reply
# thành chat-ready text: skip nếu đã sạch, match template, hoặc LLM rewrite.
# Dùng provider "default" (Qwen) — KHÔNG Gemini để tiết kiệm chi phí prod.
# Tắt nếu muốn agent reply trực tiếp (debug/regression).
BB_PM_FORMATTER_ENABLED=true
# Timeout cho LLM rewrite — sau ngưỡng này, fallback raw để user không treo.
BB_PM_FORMATTER_TIMEOUT_MS=30000
# Cap output tokens cho formatter — chat ngắn không cần nhiều.
BB_PM_FORMATTER_MAX_TOKENS=300

# ─── Channel-out (via gapo-work plugin) ────────────────────────────────
# bb-pm-tools calls gapo-work /send with this shared secret (header
# X-Plugin-Token). It must match config.sendToken in the gapo-work plugin.
GAPO_SEND_URL=http://localhost:18789/api/plugins/gapo-work/send
GAPO_SEND_TOKEN=

# ─── Browser-tools fallback (Sprint 3.5) ───────────────────────────────
# Used when Gapo bot API has no thread for the recipient. Requires the
# browser-tools plugin to be installed + authed (pnpm auth in that
# plugin). BROWSER_TOOLS_TOKEN must match the same env in browser-tools.
BROWSER_TOOLS_SEND_URL=http://localhost:18789/api/plugins/browser-tools/send-dm
BROWSER_TOOLS_FIND_URL=http://localhost:18789/api/plugins/browser-tools/find-user
BROWSER_TOOLS_TOKEN=

# ─── Redis (Sprint 3 — follow-up cooldown, Sprint 6.2 — rate limit) ────
# Optional. Without REDIS_URL the cooldown + rate limit fall back to
# in-process state — OK for single-process dev, not safe for multi-
# process production (limits won't sum across instances).
REDIS_URL=
FOLLOW_UP_COOLDOWN_SEC=86400

# ─── Rate limit on /agent/run (Sprint 6.2) ─────────────────────────────
# Set MAX_PER_WINDOW=0 to disable. Default 30 req/min/identifier.
AGENT_RUN_MAX_PER_WINDOW=30
AGENT_RUN_WINDOW_SEC=60

# ─── Cron scheduler (Sprint 2) ─────────────────────────────────────────
# Jobs are disabled unless both SCHEDULE and TARGET are set.
# TARGET is the Gapo conversation id where the bot will post.
CRON_TZ=Asia/Ho_Chi_Minh
CRON_DAILY_DIGEST=0 8 * * *
CRON_DAILY_DIGEST_TARGET=
CRON_WEEKLY_HYGIENE=0 9 * * MON
CRON_WEEKLY_HYGIENE_TARGET=

# ─── Audit log retention (Sprint 8 follow-up) ──────────────────────────
# Daily cleanup DELETE agent_audit_log WHERE created_at < NOW() - N days.
# Set 0 để tắt. Default 90 ngày. Khi row > 1M cần chuyển native partition.
AUDIT_RETENTION_DAYS=90
AUDIT_CLEANUP_SCHEDULE=0 3 * * *

# ─── Admin alerts ──────────────────────────────────────────────────────
# Khi cron / scheduler / DB automation FAIL → bot gửi tin "🚨 [ALERT] ..."
# vào Gapo channel này. Format: "collab:<id>" (group) hoặc "dm:<id>" (admin
# personal). Để trống = silent skip (dev environment, không spam).
ADMIN_ALERT_TARGET=
